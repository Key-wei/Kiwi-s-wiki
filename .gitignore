# Ignore all dot folders by default
.*

# But track .gitkeep for empty directories
!.gitkeep

# Track .gitignore itself
!.gitignore

# Track Claude, Codex, Gemini and Agents configs — root-level vault
!.claude/
.claude/*
!.claude/skills
!.claude/commands/
.claude/settings.local.json

!.gemini/
.gemini/*
!.gemini/skills
!.gemini/commands/
!.gemini/settings.json

!.codex/
.codex/*
!.codex/skills

!.agents/

# Track Claude, Codex, Gemini and Agents configs in language folders (legacy EN/CN structure)
!EN/.claude/
EN/.claude/*
!EN/.claude/skills
!EN/.claude/commands/
EN/.claude/settings.local.json

!EN/.gemini/
EN/.gemini/*
!EN/.gemini/skills
!EN/.gemini/commands/
!EN/.gemini/settings.json

!EN/.codex/
EN/.codex/*
!EN/.codex/skills

!EN/.agents/

!CN/.claude/
CN/.claude/*
!CN/.claude/skills
!CN/.claude/commands/
CN/.claude/settings.local.json

!CN/.gemini/
CN/.gemini/*
!CN/.gemini/skills
!CN/.gemini/commands/
!CN/.gemini/settings.json

!CN/.codex/
CN/.codex/*
!CN/.codex/skills

!CN/.agents/

# Node dependencies
node_modules/

# System files
.DS_Store
.trash/

# Obsidian workspace files
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Temporary files
*.tmp
*~

# Log files
*.log
.superpowers/

# MkDocs / KIWI CODEX
.venv/
site_docs/
site/
