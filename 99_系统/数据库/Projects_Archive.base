filters:
  and:
    - file.ext == "md"
    - or:
        - type == "inbox"
        - type == "project"
    - not:
        - file.inFolder("99_系统/模板")
formulas:
  display_title: file.asLink(if(title != "", title, file.basename.replace("_", " ")))
  priority_label: if(priority == "P0", "🔥 紧急", if(priority == "P1", "⚡ 高", if(priority == "P2", "📌 中", if(priority == "P3", "📋 低", "💭 以后"))))
properties:
  formula.display_title:
    displayName: 标题
  formula.priority_label:
    displayName: 优先级
  status:
    displayName: 状态
  area:
    displayName: 领域
  topic:
    displayName: 主题
views:
  - type: table
    name: ⏸️ 搁置
    filters:
      and:
        - type == "project"
        - status == "on-hold"
    order:
      - formula.display_title
      - formula.priority_label
      - due
      - area
  - type: table
    name: ✅ 已完成项目
    filters:
      and:
        - type == "project"
        - status == "done"
    order:
      - formula.display_title
      - area
  - type: table
    name: ✅ 已处理收件箱
    filters:
      and:
        - type == "inbox"
        - status == "processed"
    order:
      - formula.display_title
      - topic
    columnSize:
      formula.display_title: 285
